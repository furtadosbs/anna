<header class="card__header">
  <h2><%= t '.title' %></h2>
</header>

<% if @user.issue6 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue6_new_path, method: :post, class: "card__form", data: { turbo: false } do |form| %>
    <div class="radio">
      <%= form.radio_button :answer, User::ISSUE6_ANSWER, checked: true %>
      <%= form.label :answer, t('.option1'), value: User::ISSUE6_ANSWER %>
    </div>

    <div class="radio">
      <%= form.radio_button :answer, "protetor" %>
      <%= form.label :answer, t('.option2'), value: "protetor" %>
    </div>

    <div class="radio">
      <%= form.radio_button :answer, "agua" %>
      <%= form.label :answer, t('.option3'), value: "agua" %>
    </div>

    <div>
      <%= form.submit t('.submit'), class: "btn btn--primary" %>
    </div>
  <% end %>
<% end %>
