<header class="card__header">
  <h2><%= t '.title' %></h2>
</header>

<% if @user.issue13 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue13_new_path, method: :post, class: "card__form", data: { turbo: false } do |form| %>
    <div class="radio">
      <%= form.radio_button :answer, "lisa", checked: true %>
      <%= form.label :answer, t('.option1'), value: "lisa" %>
    </div>

    <div class="radio">
      <%= form.radio_button :answer, User::ISSUE13_ANSWER %>
      <%= form.label :answer, t('.option2'), value: User::ISSUE13_ANSWER %>
    </div>

    <div class="radio">
      <%= form.radio_button :answer, "pequena" %>
      <%= form.label :answer, t('.option3'), value: "pequena" %>
    </div>

    <div>
      <%= form.submit t('.submit'), class: "btn btn--primary" %>
    </div>
  <% end %>
<% end %>
