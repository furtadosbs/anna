<h1><%= t '.title' %></h1>

<% if @user.issue1 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue1_new_path, method: :post do |form| %>
    <div>
      <%= form.radio_button :answer, User::ISSUE1_ANSWER, checked: true %>
      <%= form.label :answer, t('.option1'), value: User::ISSUE1_ANSWER %>
    </div>

    <div>
      <%= form.radio_button :answer, "manchar" %>
      <%= form.label :answer, t('.option2'), value: "manchas" %>
    </div>

    <div>
      <%= form.radio_button :answer, "alergia" %>
      <%= form.label :answer, t('.option3'), value: "alergia" %>
    </div>

    <div>
      <%= form.submit t('.submit') %>
    </div>
  <% end %>
<% end %>
