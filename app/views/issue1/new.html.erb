<h1><%= t '.title' %></h1>

<%= form_with url: '/pergunta1', method: :post do |form| %>
  <div>
    <%= form.radio_button :answer, 1, checked: true %>
    <%= form.label :answer, t('.option1'), value: 1 %>
  </div>

  <div>
    <%= form.radio_button :answer, 2 %>
    <%= form.label :answer, t('.option2'), value: 2 %>
  </div>

  <div>
    <%= form.radio_button :answer, 3 %>
    <%= form.label :answer, t('.option3'), value: 3 %>
  </div>

  <div>
    <%= form.submit t('.submit') %>
  </div>
<% end %>
