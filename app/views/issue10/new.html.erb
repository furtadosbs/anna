<h1><%= t '.title' %></h1>

<% if @user.issue10 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue10_new_path, method: :post do |form| %>
    <div>
      <%= form.radio_button :answer, "nao", checked: true %>
      <%= form.label :answer, t('.option1'), value: "nao" %>
    </div>

    <div>
      <%= form.radio_button :answer, User::ISSUE10_ANSWER %>
      <%= form.label :answer, t('.option2'), value: User::ISSUE10_ANSWER %>
    </div>

    <div>
      <%= form.radio_button :answer, "so_verao" %>
      <%= form.label :answer, t('.option3'), value: "so_verao" %>
    </div>

    <div>
      <%= form.submit t('.submit') %>
    </div>
  <% end %>
<% end %>
