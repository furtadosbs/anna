<h1><%= t '.title' %></h1>

<% if @user.issue20 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue20_new_path, method: :post do |form| %>
    <div>
      <%= form.radio_button :answer, "desnecessario", checked: true %>
      <%= form.label :answer, t('.option1'), value: "desnecessario" %>
    </div>

    <div>
      <%= form.radio_button :answer, User::ISSUE20_ANSWER %>
      <%= form.label :answer, t('.option2'), value: User::ISSUE20_ANSWER %>
    </div>

    <div>
      <%= form.radio_button :answer, "perda_tempo" %>
      <%= form.label :answer, t('.option3'), value: "perda_tempo" %>
    </div>

    <div>
      <%= form.submit t('.submit') %>
    </div>
  <% end %>
<% end %>
