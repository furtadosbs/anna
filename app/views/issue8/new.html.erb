<h1><%= t '.title' %></h1>

<% if @user.issue8 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue8_new_path, method: :post do |form| %>
    <div>
      <%= form.radio_button :answer, "uma_vez", checked: true %>
      <%= form.label :answer, t('.option1'), value: "uma_vez" %>
    </div>

    <div>
      <%= form.radio_button :answer, User::ISSUE8_ANSWER %>
      <%= form.label :answer, t('.option2'), value: User::ISSUE8_ANSWER %>
    </div>

    <div>
      <%= form.radio_button :answer, "nunca" %>
      <%= form.label :answer, t('.option3'), value: "nunca" %>
    </div>

    <div>
      <%= form.submit t('.submit') %>
    </div>
  <% end %>
<% end %>
