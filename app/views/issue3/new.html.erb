<h1><%= t '.title' %></h1>

<% if @user.issue3 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue3_new_path, method: :post do |form| %>
    <div>
      <%= form.radio_button :answer, "nao_melanona", checked: true %>
      <%= form.label :answer, t('.option1'), value: User::ISSUE1_ANSWER %>
    </div>

    <div>
      <%= form.radio_button :answer, User::ISSUE3_ANSWER %>
      <%= form.label :answer, t('.option2'), value: User::ISSUE3_ANSWER %>
    </div>

    <div>
      <%= form.radio_button :answer, "dermatite" %>
      <%= form.label :answer, t('.option3'), value: "dermatite" %>
    </div>

    <div>
      <%= form.submit t('.submit') %>
    </div>
  <% end %>
<% end %>
