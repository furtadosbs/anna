<nav class="navbar">
  <%= link_to root_path, class: "brand navbar__brand" do %>
    <%= image_tag "brand.png"%>
    <h1>
      Sol brilhante
    </h1>

    <p>
      Proteja sua pele!
    </p>
  <% end %>
</nav>

<main class="container">
  <% @stages.each do |stage| %>
    <section class="stage">
      <header class="stage__header">
        <h2>
          <%= stage.title %>
        </h2>
      </header>

      <ul class="stage__list">
        <% stage.questions.each do |question| %>
          <%= link_to question.description, new_question_answer_path(question), class: "stage__item" %>
        <% end %>
      </ul>
    </section>
  <% end %>
</main>
