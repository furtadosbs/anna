<header class="navbar">
  <%= link_to root_path, class: "navbar__brand" do %>
    <%= image_tag "brand.png"%>
  <% end %>
</header>

<main class="container">
  <ul class="questions-list">
    <% @questions.each do |question| %>
      <li>
        <%= link_to question.description, question, class: "questions-list__link" %>
      </li>
    <% end %>
  </ul>
</main>
