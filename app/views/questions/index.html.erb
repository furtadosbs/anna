<nav class="navbar">
  <%= link_to root_path, class: "brand navbar__brand" do %>
    <%= image_tag "brand.png"%>
    <h1>
      Sol brilhante
    </h1>

    <p>
      Proteja sua pele!
    </p>
  <% end %>
</nav>

<main class="container">
  <ul class="questions">
    <% @questions.each do |question| %>
      <li>
        <%= link_to question.description, new_question_answer_path(question), class: "questions__link" %>
      </li>
    <% end %>
  </ul>
</main>
