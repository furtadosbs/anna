<div class="questions">
  <header class="navbar">
    <%= link_to root_path, class: "navbar__brand" do %>
      <%= image_tag "brand.png"%>
    <% end %>
  </header>

  <main class="container">
    <ul class="questions-list">
      <% @questions.each_with_index do |question, index| %>
        <li>
          <%= link_to question, class: "questions-list__link" do %>
            <%= index + 1 %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </main>

  <%= render "layouts/menu" %>
</div>
