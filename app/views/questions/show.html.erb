<main class="container">
  <div class="card">
    <header class="card__header">
      <h2>
        <%= @question.description %>
      </h2>
    </header>

    <div class="card__body">
      <% if Current.user.answers.where(question: @question).size >= 1 %>
        <p id="correct-message">Parabéns você acertou!</p>
      <% else %>
        <%= form_with model: [@question, @answer] , method: :post, class: "card__form", data: { turbo: false } do |form| %>
          <% @question.options.each do |option| %>
            <div class="radio">
              <%= form.label :value, option.description, value: option.value %>
              <%= form.radio_button :value, option.value %>
            </div>
          <% end %>

          <div>
            <%= form.submit 'Responder', class: 'btn btn--primary' %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="card__footer">
      <%= link_to 'Voltar', questions_path %>
    </div>
  </div>
</main>
