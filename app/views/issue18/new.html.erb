<header class="card__header">
  <h2><%= t '.title' %></h2>
</header>

<% if @user.issue18 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue18_new_path, method: :post, class: "card__form", data: { turbo: false } do |form| %>
    <div class="radio">
      <%= form.radio_button :answer, User::ISSUE18_ANSWER, checked: true %>
      <%= form.label :answer, t('.option1'), value: User::ISSUE18_ANSWER %>
    </div>

    <div class="radio">
      <%= form.radio_button :answer, "sem_protecao" %>
      <%= form.label :answer, t('.option2'), value: "sem_protecao" %>
    </div>

    <div class="radio">
      <%= form.radio_button :answer, "sol_dia_todo" %>
      <%= form.label :answer, t('.option3'), value: "sol_dia_todo" %>
    </div>

    <div>
      <%= form.submit t('.submit'), class: "btn btn--primary" %>
    </div>
  <% end %>
<% end %>
