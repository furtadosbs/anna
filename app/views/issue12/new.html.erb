<h1><%= t '.title' %></h1>

<% if @user.issue12 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue12_new_path, method: :post do |form| %>
    <div>
      <%= form.radio_button :answer, "sim", checked: true %>
      <%= form.label :answer, t('.option1'), value: "sim" %>
    </div>

    <div>
      <%= form.radio_button :answer, User::ISSUE12_ANSWER %>
      <%= form.label :answer, t('.option2'), value: User::ISSUE12_ANSWER %>
    </div>

    <div>
      <%= form.radio_button :answer, "depende" %>
      <%= form.label :answer, t('.option3'), value: "depende" %>
    </div>

    <div>
      <%= form.submit t('.submit') %>
    </div>
  <% end %>
<% end %>
