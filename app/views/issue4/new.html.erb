<h1><%= t '.title' %></h1>

<% if @user.issue4 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue4_new_path, method: :post do |form| %>
    <div>
      <%= form.radio_button :answer, "agua", checked: true %>
      <%= form.label :answer, t('.option1'), value: 'agua' %>
    </div>

    <div>
      <%= form.radio_button :answer, User::ISSUE4_ANSWER %>
      <%= form.label :answer, t('.option2'), value: User::ISSUE4_ANSWER %>
    </div>

    <div>
      <%= form.radio_button :answer, "dormir" %>
      <%= form.label :answer, t('.option3'), value: "dormir" %>
    </div>

    <div>
      <%= form.submit t('.submit') %>
    </div>
  <% end %>
<% end %>
