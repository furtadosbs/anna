<h1><%= t '.title' %></h1>

<% if @user.issue14 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue14_new_path, method: :post do |form| %>
    <div>
      <%= form.radio_button :answer, "uma_cor", checked: true %>
      <%= form.label :answer, t('.option1'), value: "uma_cor" %>
    </div>

    <div>
      <%= form.radio_button :answer, User::ISSUE14_ANSWER %>
      <%= form.label :answer, t('.option2'), value: User::ISSUE14_ANSWER %>
    </div>

    <div>
      <%= form.radio_button :answer, "cor_pele" %>
      <%= form.label :answer, t('.option3'), value: "cor_pele" %>
    </div>

    <div>
      <%= form.submit t('.submit') %>
    </div>
  <% end %>
<% end %>
