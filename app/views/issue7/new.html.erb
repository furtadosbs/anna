
<header class="card__header">
  <h2><%= t '.title' %></h2>
</header>

<% if @user.issue7 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue7_new_path, method: :post, class: "card__form", data: { turbo: false } do |form| %>
    <div class="radio">
      <%= form.radio_button :answer, "fps_10", checked: true %>
      <%= form.label :answer, t('.option1'), value: "fps_10" %>
    </div>

    <div class="radio">
      <%= form.radio_button :answer, User::ISSUE7_ANSWER %>
      <%= form.label :answer, t('.option2'), value: User::ISSUE7_ANSWER %>
    </div>

    <div class="radio">
      <%= form.radio_button :answer, "nao_precisa" %>
      <%= form.label :answer, t('.option3'), value: "nao_precisa" %>
    </div>

    <div>
      <%= form.submit t('.submit'), class: "btn btn--primary" %>
    </div>
  <% end %>
<% end %>
