<header class="card__heade">
  <h2><%= t '.title' %></h2>
</header>

<% if @user.issue2 %>
  <p><%= t('.already_answered') %></p>
<% else %>
  <%= form_with url: issue2_new_path, method: :post, class: "card__form", data: { turbo: false } do |form| %>
    <div class="radio">
      <%= form.radio_button :answer, "melanona", checked: true %>
      <%= form.label :answer, t('.option1'), value: "melanona" %>
    </div>

    <div class="radio">
      <%= form.radio_button :answer, User::ISSUE2_ANSWER %>
      <%= form.label :answer, t('.option2'), value: User::ISSUE2_ANSWER %>
    </div>

    <div class="radio">
      <%= form.radio_button :answer, "sarcoma" %>
      <%= form.label :answer, t('.option3'), value: "sarcoma" %>
    </div>

    <div>
      <%= form.submit t('.submit'), class: "btn btn--primary" %>
    </div>
  <% end %>
<% end %>
